# Copy this file to .env.local (or .env) and fill in real values. Never commit
# the filled-in file — .gitignore already excludes .env / .env.* except this
# example file.
#
# Both variables are read at build/runtime by src/lib/supabase.ts. They must
# be prefixed EXPO_PUBLIC_ to be inlined into the Expo web/native bundle
# (Expo's convention for client-safe env vars — see expo-env.d.ts).
#
# Values come from the Supabase dashboard for the `lorewish-dev` project
# (ref sfarcofvqfeobtcizxyv): Project Settings -> API.
#
# EXPO_PUBLIC_SUPABASE_URL is the project's REST/Auth base URL, e.g.
# https://sfarcofvqfeobtcizxyv.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the modern PUBLISHABLE key
# (prefix "sb_publishable_..."), safe to ship in client code. Do NOT put a
# service-role or secret key here, and do NOT put a database password or a
# Supabase management/access token in this file or any other tracked file.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
