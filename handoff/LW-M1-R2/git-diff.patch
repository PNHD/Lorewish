+          updated_at?: string
+          world_setting?: string | null
+        }
+        Relationships: [
+          {
+            foreignKeyName: "story_configurations_story_id_fkey"
+            columns: ["story_id"]
+            isOneToOne: true
+            referencedRelation: "stories"
+            referencedColumns: ["id"]
