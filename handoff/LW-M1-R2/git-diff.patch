+--- /dev/null
++++ b/src/hooks/use-color-scheme.web.ts
+@@ -0,0 +1,25 @@
++import { useEffect, useState } from 'react';
++import { useColorScheme as useRNColorScheme } from 'react-native';
++
++/**
++ * To support static rendering, this value needs to be re-calculated on the client side for web
++ */
++export function useColorScheme() {
++  const [hasHydrated, setHasHydrated] = useState(false);
++
++  useEffect(() => {
++    // Intentional one-time client-only re-render for static-rendering
++    // hydration safety (Expo's own template pattern) — not a state sync
++    // this component could instead derive during render.
++    // eslint-disable-next-line react-hooks/set-state-in-effect
++    setHasHydrated(true);
++  }, []);
++
++  const colorScheme = useRNColorScheme();
++
++  if (hasHydrated) {
++    return colorScheme;
++  }
++
++  return 'light';
++}
