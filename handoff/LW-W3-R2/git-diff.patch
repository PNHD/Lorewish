+      )}
+      <NarrativeBlock paragraphs={scene.narrative.split(/\n\n+/)} />
+      {scene.dialogue.map((line, index) => <DialogueLine key={`${scene.id}:${index}`} speaker={line.speaker} line={line.line} />)}
